# Swaniki Radar Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
# Leave empty or set to mongodb://localhost:27017/swaniki_radar
# If unreachable in development, an embedded in-memory MongoDB will be used automatically.
MONGODB_URI=mongodb://localhost:27017/swaniki_radar

# AI Provider Configuration (Optional; deterministic fallback used when unset/mock or on failure)
# Supported providers: 'gemini', 'openai', 'mock'
# Real HTTPS calls are only made when AI_PROVIDER selects a provider AND its API key is set.
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.6
AI_DAILY_CALL_LIMIT=500

# Import / upload limits
# Max JSON body accepted by the API (CSV content is embedded in JSON).
JSON_BODY_LIMIT=30mb
# Max spreadsheet file size in bytes (default 10 GB) enforced per import request.
IMPORT_MAX_FILE_BYTES=10737418240
# Max data rows accepted per import request (default 10 million).
IMPORT_MAX_ROWS=10000000
# Chunk size for resumable multipart streaming upload (default 10 MB).
IMPORT_CHUNK_SIZE_BYTES=10485760
# Files larger than this threshold (default 50 MB) use fast row estimation for the preview.
IMPORT_ESTIMATION_THRESHOLD_BYTES=52428800
# Rows persisted per bulk database write batch.
IMPORT_BATCH_SIZE=500
# Maximum number of concurrent bulk write batches (memory bound).
IMPORT_WRITE_CONCURRENCY=2
# Number of sample rows returned by the streaming inspector.
IMPORT_MAX_PREVIEW_ROWS=20
# Row-level errors kept inline on the job document (full report is written to disk).
IMPORT_ERROR_SAMPLE_LIMIT=500
# Directory for temporary uploaded files and error reports.
IMPORT_UPLOAD_DIR=
# Temporary uploads older than this many hours are purged on boot.
IMPORT_TEMP_TTL_HOURS=24

# Durable Campaign Scheduler (restart-safe background worker; no Redis required)
CAMPAIGN_SCHEDULER_ENABLED=true
CAMPAIGN_SCHEDULER_INTERVAL_MS=60000

# Email Provider Configuration
# Set to 'mock' for local development; 'gmail' or 'smtp' when credentials configured
EMAIL_PROVIDER=mock
EMAIL_DAILY_SEND_LIMIT=100

# Security & Sessions
JWT_SECRET=super-secret-dev-jwt-key-replace-in-production-12345678
SESSION_SECRET=swaniki-session-secret-key-32-chars-long-min!
OAUTH_TOKEN_ENCRYPTION_KEY=dev-oauth-token-aes-encryption-key-32-bytes!
DEV_MOCK_USER_ID=usr_dev_master_001
DEV_MOCK_ORG_ID=org_dev_swaniki_001

# Google OAuth 2.0 / OpenID Connect (Sign-In)
# Obtain from Google Cloud Console > Credentials > OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# Google Gmail API Integration (Separate Mailbox Connection)
# Authorized redirect URI in Google Cloud Console
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:5000/api/v1/integrations/google/gmail/callback

# Gmail API quota control (per connected mailbox / per Google user)
# Google's published ceiling is 6,000 quota units per minute per user.
GMAIL_QUOTA_UNITS_PER_MINUTE=6000
# Fraction of the published quota the scheduler may use (headroom for interactive work).
GMAIL_QUOTA_SAFETY_FACTOR=0.8
# Maximum instantaneous burst of quota units a single mailbox may spend.
GMAIL_QUOTA_BURST_UNITS=600
# Maximum concurrent Gmail API calls per connected mailbox (shared across workers).
GMAIL_MAX_CONCURRENT_CALLS=4
# Automatic retries for a single Gmail API call after a 429/5xx/network error.
GMAIL_MAX_RETRIES=3
# Base delay (ms) for exponential backoff with jitter on retryable Gmail errors.
GMAIL_RETRY_BASE_DELAY_MS=500
# Upper bound (ms) for a single backoff delay.
GMAIL_RETRY_MAX_DELAY_MS=60000
# How long a background sync may wait for quota before deferring to the next tick.
GMAIL_SYNC_MAX_WAIT_MS=2000

# Gmail API project quota (shared by every mailbox of the same Google Cloud project).
# Google meters the daily sending quota per *project*, not per mailbox: connecting
# more Gmail accounts does not raise the ceiling, it only shares the same budget.
GMAIL_PROJECT_DAILY_QUOTA_UNITS=1000000
# Fraction of the project quota the scheduler may spend.
GMAIL_PROJECT_QUOTA_SAFETY_FACTOR=0.9

# Multi-mailbox campaign pacing (defaults for every sender account of a campaign;
# each account may override them on the campaign page).
# Minimum spacing between two sends of the same mailbox (seconds).
CAMPAIGN_SENDER_MIN_INTERVAL_SECONDS_DEFAULT=60
# Randomized extra spacing added on top of the minimum (seconds).
CAMPAIGN_SENDER_JITTER_SECONDS_DEFAULT=30
# Maximum sends per hour and per mailbox.
CAMPAIGN_SENDER_MAX_PER_HOUR_DEFAULT=60
# Maximum sends per day and per mailbox.
CAMPAIGN_SENDER_DAILY_CAP_DEFAULT=100
# Hard ceilings a user may not exceed from the UI.
CAMPAIGN_SENDER_MAX_PER_HOUR_MAX=1000
CAMPAIGN_SENDER_DAILY_CAP_MAX=2000
